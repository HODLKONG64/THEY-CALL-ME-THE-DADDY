{
  "version": "1.1",
  "mission": "self_repair_first",
  "priorities": [
    "self_repair",
    "recovery",
    "stability",
    "observability",
    "decision_quality",
    "memory"
  ],
  "rules": {
    "no_deadlock": true,
    "no_empty_cycles": true,
    "require_patch_or_recovery": true,
    "force_patch_under_pressure": true,
    "rollback_on_failure": true,
    "avoid_duplicate_patches": true,
    "bounded_patches_only": true,
    "recover_on_merge_conflict": true,
    "retry_smaller_after_failure": true,
    "recover_on_next_run_after_failure": true,
    "target_recent_failure_before_helper_fallback": true,
    "stuck_state_openai_escalation": true,
    "doctor_takeover_after_openai_fix": true,
    "suppress_helper_fallback_when_execution_targets_required": true
  },
  "thresholds": {
    "pressure_score_force_action": 6,
    "no_patch_streak_limit": 3,
    "max_retry_attempts": 3,
    "success_rate_minimum": 0.7,
    "max_failure_recovery_lookback_runs": 2,
    "max_proven_success_anchors": 2,
    "stuck_same_reason_limit": 2
  },
  "fallback_strategy": {
    "on_no_patch": "force_bounded_patch",
    "on_repeat_no_patch": "shrink_patch_scope",
    "on_failure": "rollback_and_retry_smaller",
    "on_merge_conflict": "rebase_reapply_reopen_pr",
    "on_run_failure": "rollback_and_retry_smaller",
    "on_next_run_after_failure": "rollback_latest_failed_run_then_retry",
    "on_stuck_state": "request_fresh_openai_guidance_then_doctor_takeover"
  },
  "forbidden": [
    "large_unbounded_rewrites",
    "duplicate_patches",
    "touching_protected_files_without_reason",
    "empty_return_cycles",
    "helper_lane_filler_when_execution_targets_are_required"
  ]
}