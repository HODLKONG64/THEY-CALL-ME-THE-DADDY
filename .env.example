# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-5.4
OPENAI_MODEL_REVIEW=gpt-5.4
OPENAI_MODEL_VET=gpt-5.4-mini
OPENAI_MODEL_LIGHT=gpt-5.4-nano
OPENAI_TIMEOUT_SECONDS=90

# Runtime
DADDY_COMMAND=pytest -q
DADDY_MAINTENANCE_COMMAND=pytest -q
DADDY_TARGET_ROOT=.
DADDY_MAX_ATTEMPTS=4
DADDY_MAX_FILE_BYTES=120000
DADDY_RUN_TIMEOUT_SECONDS=1200
DADDY_HEARTBEAT_SECONDS=5
DADDY_ENABLE_PATCHING=true
DADDY_ENABLE_TEST_GENERATION=true
DADDY_ENABLE_SELF_EVOLUTION=true
DADDY_SELF_EVOLUTION_MAX_ACTIONS=3
DADDY_ALLOW_EXTENSIONS=.py,.js,.ts,.tsx,.jsx,.json,.yml,.yaml,.toml,.md

# GitHub / PR lane
GITHUB_TOKEN=
GITHUB_REPO=HODLKONG64/THEY-CALL-ME-THE-DADDY

# Target-repo safety guards
# Comma-separated list of repos Daddy is allowed to push/PR/merge to.
# Defaults to Daddy self-repair only (HODLKONG64/THEY-CALL-ME-THE-DADDY) when unset or empty.
# To enable SWARMSY external mode also add: HODLKONG64/SWARMSY
DADDY_ALLOWED_TARGET_REPOS=HODLKONG64/THEY-CALL-ME-THE-DADDY
# Allow Daddy to auto-merge PRs in SWARMSY external mode. Defaults false (open PRs only).
DADDY_SWARMSY_AUTO_MERGE=false


R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=the-daddy-memory
R2_REGION=auto

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
